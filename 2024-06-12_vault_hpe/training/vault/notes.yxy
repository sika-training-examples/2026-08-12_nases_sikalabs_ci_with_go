vault write auth/oidc/role/manager \
  bound_audiences="default" \
  allowed_redirect_uris="https://vault.k8s.sikademo.com/ui/vault/auth/oidc/oidc/callback" \
  allowed_redirect_uris="http://localhost:8250/oidc/callback" \
  user_claim="email" \
  token_policies="manager" \
  groups_claim="groups" \
  allowed_groups="vault-manager"


vault write auth/oidc/role/default \
  bound_audiences="default" \
  allowed_redirect_uris="https://vault.k8s.sikademo.com/ui/vault/auth/oidc/oidc/callback" \
  allowed_redirect_uris="http://localhost:8250/oidc/callback" \
  user_claim="email" \
  token_policies="reader" \
  allowed_groups="vault-reader" \
    groups_claim="groups" \
  allowed_groups="vault-reader"


vault write database/config/postgresql \
  plugin_name=postgresql-database-plugin \
  connection_url="postgresql://{{username}}:{{password}}@lab0.sikademo.com:5432/postgres?sslmode=disable" \
  allowed_roles=readonly \
  username="postgres" \
  password="pg"

vault write auth/kubernetes/role/test-read \
  bound_service_account_names=default \
  bound_service_account_namespaces=default \
  policies=test-read \
  audience=vault \
  ttl=24h