[Unit]
Description={{ service_name }}
After=network.target

[Service]
{% for env_name, env_val in env.items() %}
Environment="{{ env_name }}={{ env_val }}"
{% endfor %}
Type=simple
ExecStart={{ exec_start }}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
